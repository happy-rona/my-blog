---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "bg-muted text-foreground inline-block rounded px-2 py-0.5",
      "hover:bg-muted-foreground/25",
      { "text-sm": size === "sm" },
      { "text-base": size === "lg" },
    ]}
  >
    {tagName}
  </a>
</li>
